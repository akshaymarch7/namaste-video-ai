{
  "name": "namastevideo-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pipeline": "node --env-file-if-exists=.env.local --import tsx src/cli.ts",
    "studio": "remotion studio src/video/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:web && npm test",
    "dev": "npm run dev --workspace=@namastevideo/web",
    "build": "npm run build --workspace=@namastevideo/web",
    "start": "npm run start --workspace=@namastevideo/web",
    "typecheck:web": "npm run typecheck --workspace=@namastevideo/web",
    "db:setup": "npm run db:setup --workspace=@namastevideo/web",
    "test:db": "npm run test:db --workspace=@namastevideo/web",
    "test:auth": "npm run test:auth --workspace=@namastevideo/web --",
    "auth:operator": "npm run auth:operator --workspace=@namastevideo/web --",
    "auth:local": "npm run auth:local --workspace=@namastevideo/web --",
    "auth:verify": "npm run auth:verify --workspace=@namastevideo/web --",
    "test:projects": "npm run test:projects --workspace=@namastevideo/web --",
    "projects:verify": "npm run projects:verify --workspace=@namastevideo/web --",
    "projects:openapi": "npm run projects:openapi --workspace=@namastevideo/web --",
    "test:library": "npm run test:library --workspace=@namastevideo/web --",
    "test:drafts": "npm run test:drafts --workspace=@namastevideo/web --",
    "drafts:verify": "npm run drafts:verify --workspace=@namastevideo/web --",
    "test:ideas": "npm run test:ideas --workspace=@namastevideo/web --",
    "ideas:probe": "npm run ideas:probe --workspace=@namastevideo/web --",
    "test:storyboards": "npm run test:storyboards --workspace=@namastevideo/web --",
    "storyboards:probe": "npm run storyboards:probe --workspace=@namastevideo/web --",
    "storyboards:verify": "npm run storyboards:verify --workspace=@namastevideo/web --",
    "test:storyboard-ui": "npm run test:storyboard-ui --workspace=@namastevideo/web --",
    "storyboards:worker": "npm run storyboards:worker --workspace=@namastevideo/web --",
    "test:storage": "npm run test:storage --workspace=@namastevideo/web --"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "remotion": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12",
    "@fontsource/dm-sans": "5.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/web"
  ]
}
