# Static scaffold pages require no environment variables.
# Never copy provider secrets into NEXT_PUBLIC_* variables.
MONGODB_URI=
MONGODB_DATABASE=namastevideo_dev
# Separate operator credential with collection/index setup privileges; no fallback to runtime URI.
# Use only for the explicit db:setup command, not in the hosted web runtime.
MONGODB_MIGRATION_URI=
# Generate a random secret of at least 32 characters; keep it server-only.
BETTER_AUTH_SECRET=
# Exact browser origin. Production requires HTTPS; development permits loopback HTTP.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Set only if the trusted proxy overwrites/removes user-supplied values.
# Supported: x-vercel-forwarded-for or x-real-ip. Empty uses a shared conservative IP bucket.
AUTH_CLIENT_IP_HEADER=

# Server-only F08b provider configuration; root prototype settings are not loaded.
GEMINI_API_KEY=
# Set an exact model available to your account; no silent fallback.
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=

# F12: private media. Separate dev bucket; never enable public r2.dev access.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_GATEWAY_ORIGIN=
# Same random 32+ character secret in the gateway Worker and web authorization route.
MEDIA_SERVICE_SECRET=

# F13: explicit local Inngest mode; leave blank until running its dev server.
INNGEST_DEV=
# Hosted orchestration only; deployment remains a separate action.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# F18: server-only. HTTPS callback must share BETTER_AUTH_URL origin.
# New connections require Instagram Login product credentials, not Facebook app Basic credentials.
INSTAGRAM_LOGIN_PROVIDER=instagram
# Legacy Facebook configuration only; new Facebook connections are disabled.
INSTAGRAM_FACEBOOK_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Explicit version supported by your Meta app, e.g. vXX.0; no implicit latest version.
INSTAGRAM_GRAPH_VERSION=
# JSON key ring: {"k1":"<32 random bytes in standard base64>"}; retain old keys during rotation.
INSTAGRAM_TOKEN_KEY_ID=
INSTAGRAM_TOKEN_KEYS=

# Hosted dispatch stays OFF until migrations, IAM, secrets, scheduler and live QA pass.
# Vercel OIDC -> Google WIF; no downloaded Google service-account key.
CLOUD_RUN_ENABLED=
CLOUD_RUN_PROJECT=namastevideo-dev-20261007
CLOUD_RUN_PROJECT_NUMBER=822836666275
CLOUD_RUN_REGION=us-east1
CLOUD_RUN_IDENTITY_POOL=
CLOUD_RUN_IDENTITY_PROVIDER=
# Exact us-central1 Artifact Registry worker image, pinned with @sha256:<digest>.
CLOUD_RUN_IMAGE=
# Explicit ISO UTC activation cutoff; older queued work is never dispatched.
CLOUD_RUN_NOT_BEFORE=
# Counts attempted launches across both roles, UTC day; allowed 1..20.
CLOUD_RUN_DAILY_LIMIT=10
# Random 32+ character server-only bearer shared only with Cloud Scheduler.
CLOUD_RUN_SCHEDULER_SECRET=

# F19: off until separately approved live publishing activation.
INSTAGRAM_PUBLISH_ENABLED=0
# Separate bearer for POST /api/internal/publish-tick; never use auth/media secrets.
INSTAGRAM_PUBLISH_SCHEDULER_SECRET=

# Separate token-maintenance capability; does not enable publishing or rendering.
# Leave disabled until its own bounded live acceptance and recurring-operation approval.
INSTAGRAM_REFRESH_ENABLED=0
INSTAGRAM_REFRESH_SCHEDULER_SECRET=

# Signed Meta deauthorization callbacks; migrate 020 and verify product mapping first.
INSTAGRAM_LIFECYCLE_ENABLED=0
