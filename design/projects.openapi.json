{
  "openapi": "3.1.0",
  "info": {
    "title": "NamasteVideo project and idea draft API",
    "version": "0.2.0",
    "description": "Implemented slice only. DELETE completes synchronously for empty projects (204); populated project cleanup and selectedVideoId mutation are not yet supported."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "revision",
          "draftRevision",
          "conversationId",
          "currentStoryboardId",
          "latestReadyVideoId",
          "selectedVideoId",
          "activeJobId",
          "flags",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "string",
            "pattern": "^prj_[A-Za-z0-9_-]{16,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "draftRevision": {
            "type": "integer",
            "minimum": 1
          },
          "conversationId": {
            "type": "string"
          },
          "currentStoryboardId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "latestReadyVideoId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "selectedVideoId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "activeJobId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "flags": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "drafts",
              "ready",
              "scheduled",
              "published",
              "needsAttention"
            ],
            "properties": {
              "drafts": {
                "type": "boolean"
              },
              "ready": {
                "type": "boolean"
              },
              "scheduled": {
                "type": "boolean"
              },
              "published": {
                "type": "boolean"
              },
              "needsAttention": {
                "type": "boolean"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Safe error envelope; see API_DESIGN.md for error codes.",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string"
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error",
                "meta"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "requestId",
                    "retryable"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "details": {
                      "type": "object"
                    }
                  }
                },
                "meta": {
                  "type": "object",
                  "required": [
                    "requestId"
                  ],
                  "properties": {
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Better Auth HttpOnly session cookie; production uses its __Secure- prefix. Obtain it via the session facade."
      }
    }
  },
  "paths": {
    "/api/projects/{id}/draft": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "string",
            "pattern": "^prj_[A-Za-z0-9_-]{16,64}$"
          }
        }
      ],
      "get": {
        "operationId": "getIdeaDraft",
        "responses": {
          "200": {
            "description": "Current idea draft. Validation is false until storyboard approval exists. No provider availability is implied.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "requestId"
                      ],
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
                      }
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "projectId",
                        "conversationId",
                        "revision",
                        "topic",
                        "audience",
                        "notes",
                        "voicePreset",
                        "editablePlan",
                        "sourceStoryboardId",
                        "planStale",
                        "contentHash",
                        "validation",
                        "updatedAt"
                      ],
                      "properties": {
                        "projectId": {
                          "$schema": "https://json-schema.org/draft/2020-12/schema",
                          "type": "string",
                          "pattern": "^prj_[A-Za-z0-9_-]{16,64}$"
                        },
                        "conversationId": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "topic": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "audience": {
                          "type": "string",
                          "maxLength": 200
                        },
                        "notes": {
                          "type": "string",
                          "maxLength": 20000
                        },
                        "voicePreset": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "editablePlan": {
                          "type": "null"
                        },
                        "sourceStoryboardId": {
                          "type": "null"
                        },
                        "planStale": {
                          "const": false
                        },
                        "contentHash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "validation": {
                          "type": "object",
                          "required": [
                            "valid",
                            "issues"
                          ],
                          "properties": {
                            "valid": {
                              "const": false
                            },
                            "issues": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "path",
                                  "code",
                                  "message"
                                ],
                                "properties": {
                                  "path": {
                                    "type": "string"
                                  },
                                  "code": {
                                    "type": "string"
                                  },
                                  "message": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "operationId": "saveIdeaDraft",
        "description": "Requires expectedRevision. Supports topic/audience/notes/voicePreset only. New voice choices allow daniel-test; existing saved preset may be retained. No idempotency key: after an unknown response read and compare before retrying; never silently overwrite a newer revision.",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match configured application origin."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483646
                  },
                  "changes": {
                    "type": "object",
                    "properties": {
                      "topic": {
                        "type": "string",
                        "maxLength": 2000,
                        "description": "Unicode code points; whitespace preserved."
                      },
                      "audience": {
                        "type": "string",
                        "maxLength": 200,
                        "description": "Unicode code points; whitespace preserved."
                      },
                      "notes": {
                        "type": "string",
                        "maxLength": 20000,
                        "description": "Unicode code points; whitespace preserved."
                      },
                      "voicePreset": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  }
                },
                "required": [
                  "expectedRevision",
                  "changes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current idea draft. Validation is false until storyboard approval exists. No provider availability is implied.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "meta": {
                      "type": "object",
                      "required": [
                        "requestId"
                      ],
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
                      }
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "projectId",
                        "conversationId",
                        "revision",
                        "topic",
                        "audience",
                        "notes",
                        "voicePreset",
                        "editablePlan",
                        "sourceStoryboardId",
                        "planStale",
                        "contentHash",
                        "validation",
                        "updatedAt"
                      ],
                      "properties": {
                        "projectId": {
                          "$schema": "https://json-schema.org/draft/2020-12/schema",
                          "type": "string",
                          "pattern": "^prj_[A-Za-z0-9_-]{16,64}$"
                        },
                        "conversationId": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "topic": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "audience": {
                          "type": "string",
                          "maxLength": 200
                        },
                        "notes": {
                          "type": "string",
                          "maxLength": 20000
                        },
                        "voicePreset": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "editablePlan": {
                          "type": "null"
                        },
                        "sourceStoryboardId": {
                          "type": "null"
                        },
                        "planStale": {
                          "const": false
                        },
                        "contentHash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "validation": {
                          "type": "object",
                          "required": [
                            "valid",
                            "issues"
                          ],
                          "properties": {
                            "valid": {
                              "const": false
                            },
                            "issues": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "path",
                                  "code",
                                  "message"
                                ],
                                "properties": {
                                  "path": {
                                    "type": "string"
                                  },
                                  "code": {
                                    "type": "string"
                                  },
                                  "message": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "filter",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "drafts",
                "ready",
                "scheduled",
                "published",
                "needs_attention"
              ],
              "default": "all"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "description": "Signed owner/filter-bound tuple cursor, valid for 24 hours. Live lists may move after edits; deduplicate by ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped live project list",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "page",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "page": {
                      "type": "object",
                      "required": [
                        "hasMore",
                        "nextCursor"
                      ],
                      "properties": {
                        "hasMore": {
                          "type": "boolean"
                        },
                        "nextCursor": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "requestId"
                      ],
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match configured application origin."
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string",
              "pattern": "^[\\x21-\\x7e]{16,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "title": {
                    "default": "Untitled video",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Trimmed plain text, 1–100 Unicode code points."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project, blank draft and conversation created atomically",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "const": "true"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Project"
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "requestId"
                      ],
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/projects/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "string",
            "pattern": "^prj_[A-Za-z0-9_-]{16,64}$"
          }
        }
      ],
      "get": {
        "operationId": "getProject",
